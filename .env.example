# Belune — production environment
#
# A seed, not a reference: the values an operator actually sets on a fresh
# install. Everything else has a working default in the code.
#
# Full reference for every variable: docs/configuration.md
#
# scripts/install.sh does NOT copy this file — it generates .env with freshly
# random secrets, because a shipped template containing JWT_SECRET or
# ENCRYPTION_KEY would hand every install on the internet the same keys. This
# file is downloaded beside it so the options are readable on the box.

# ─────────────────────────────────────────────────────────────────────────────
# Required — no safe default. The installer generates these.
# ─────────────────────────────────────────────────────────────────────────────

POSTGRES_USER=belune
POSTGRES_DB=belune
POSTGRES_PASSWORD=
DATABASE_URL=postgres://belune:@postgres:5432/belune?sslmode=disable

# Signs session tokens. Rotating it logs everyone out.
JWT_SECRET=

# Encrypts stored secrets: git credentials, webhook secrets, SMTP and backup
# destination passwords. Losing it makes those unreadable — back it up with the
# database, and read docs/runbooks/key-rotation.md before changing it.
ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Serving
# ─────────────────────────────────────────────────────────────────────────────

REDIS_URL=redis://redis:6379
CADDY_ADMIN_URL=http://caddy:2019
PORT=8080

# The image the stack runs.
BELUNE_IMAGE=ghcr.io/weiliang79/belune:latest

# The Caddy image. Unset uses Belune's build: upstream Caddy plus optional modules
# (rate limiting, DNS providers, WAF, CrowdSec, layer4). Stock upstream Caddy is
# fully supported — a feature whose module is missing shows as "not configured".
# BELUNE_CADDY_IMAGE=caddy:2-alpine

# Host docker group ID, so the container can reach the Docker socket.
DOCKER_GID=

# ─────────────────────────────────────────────────────────────────────────────
# Set these once the dashboard has a hostname
# ─────────────────────────────────────────────────────────────────────────────

# Comma-separated. Add your dashboard hostname.
CORS_ORIGINS=http://localhost

# Sends HSTS headers once Caddy terminates TLS for the dashboard.
TLS_ENABLED=false

# Public dashboard URL. Required once SMTP is configured, so email links resolve.
PUBLIC_BASE_URL=

# Public URL git providers call back on.
WEBHOOK_PUBLIC_URL=

# Address domains must point at. Blank auto-detects; set it when the box is
# behind NAT. The Server IP setting in the dashboard overrides this.
BELUNE_PUBLIC_IP=

# ─────────────────────────────────────────────────────────────────────────────
# Optional — defaults are sensible. See docs/configuration.md before changing.
# ─────────────────────────────────────────────────────────────────────────────

# debug | info | warn | error
LOG_LEVEL=info

# console (human-readable) | json (for log shippers)
LOG_FORMAT=console

# Email. Also configurable from Server → Configuration, which wins over these.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Belune
SMTP_TLS_MODE=starttls

# Control-plane backups: Belune's own database and Caddy's certificates.
BACKUP_REMOTE_ENABLED=false
BACKUP_RETAIN_COUNT=14
BACKUP_RETAIN_DAYS=30
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PREFIX=belune/
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_USE_SSL=true

# Observability. Empty endpoint = no-op tracer. The bundled Prometheus/Grafana/
# Jaeger stack is opt-in via infra/compose.observability.yml and is not started
# by default — pointing at a collector that is not running makes the exporter
# retry every ten seconds. The endpoint takes either host:port (jaeger:4318)
# or a full URL (https://api.honeycomb.io) — with a URL the scheme decides
# TLS and INSECURE is ignored, so a hosted collector cannot be downgraded.
METRICS_BIND=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true

# Shown in the database tunnel command. Set when SSH lands on a different box,
# such as a bastion; otherwise the resolved server IP is used.
SERVER_SSH_HOST=
SERVER_SSH_USER=

# Worker ceilings and per-user limits.
BUILD_TIMEOUT_MINUTES=30
IMAGE_PULL_TIMEOUT_MINUTES=10
TASK_TIMEOUT_MINUTES=45
MAX_WEBSOCKET_CONNS_PER_USER=20
MAX_TERMINAL_SESSIONS_PER_USER=5
