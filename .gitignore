# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
belune
apps/api/server

# Go
apps/api/tmp/
apps/api/frontend/*.html
apps/api/frontend/*.js
apps/api/frontend/*.css
apps/api/frontend/**/*
!apps/api/frontend/.gitkeep

# Node
node_modules/
dist/
# ...except the placeholder that keeps apps/api/web/dist/ in the tree. The Go
# binary embeds that directory with //go:embed, and an embed of a directory that
# does not exist is a compile error — so without this file a fresh clone cannot
# build at all. Git will not track an empty directory, and it will not re-include
# a file whose parent directory is excluded, hence the three-step dance.
!apps/api/web/dist/
apps/api/web/dist/*
!apps/api/web/dist/.gitkeep
.svelte-kit/

# Environment
.env
.env.local
.env.*.local
backup-remote.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# sqlc output is committed (no `sqlc generate` step in CI/Docker), so a fresh
# clone builds without sqlc installed. Regenerate with `sqlc generate`.

# Caddy logs (bind mount from container)
infra/caddy/logs/

# Test
coverage/
*.out

# Local dev backup dump dir (DATABASE_BACKUP_DIR)
.belune-data/
# Pre-rename name for the same directory. Kept because the rename moved the
# ignore rule, which un-ignored the old directory and swept a database dump into
# a commit — and any dev with a pre-rename checkout still has one on disk.
.paas-data/
belune-trial.tgz
.env.smoke

# An npm/npx invocation from the repo ROOT writes an empty lockfile here, beside
# no package.json. The leading slash is load-bearing: an unanchored
# `package-lock.json` matches at any depth and would ignore apps/web's and
# apps/site's real, tracked lockfiles too.
/package-lock.json
