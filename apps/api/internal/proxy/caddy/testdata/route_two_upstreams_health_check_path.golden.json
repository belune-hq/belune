{
  "@id": "route-app.example.com",
  "match": [
    {
      "host": [
        "app.example.com"
      ]
    }
  ],
  "handle": [
    {
      "handler": "reverse_proxy",
      "health_checks": {
        "active": {
          "expect_status": 2,
          "interval": "30s",
          "timeout": "5s",
          "uri": "/healthz"
        },
        "passive": {
          "fail_duration": "10s",
          "max_fails": 3
        }
      },
      "load_balancing": {
        "try_duration": "2s",
        "try_interval": "250ms"
      },
      "upstreams": [
        {
          "dial": "proj-app-1234abcd-web-1:8080"
        },
        {
          "dial": "proj-app-1234abcd-web-2:8080"
        }
      ]
    }
  ]
}
