# Prettier does not read .gitignore, so anything it should skip belongs here.

# Regenerated by the TanStack Router plugin on every dev and build run, and
# CLAUDE.md forbids hand-editing it. Formatting it would be silently undone the
# next time someone adds a route, turning `--check` red for nobody's change.
src/routeTree.gen.ts

# Build output and test artefacts. These are gitignored, but a developer who has
# run a build or a Playwright drill would otherwise fail `--check` on files they
# never wrote.
dist/
build/
coverage/
test-results/
playwright-report/
blob-report/
.playwright/
